<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3052FF95">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#0A100D" />
                    <stroke android:width="1dp" android:color="#1B2A21" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="#173725" />
                    <stroke android:width="2dp" android:color="@color/matrix_green" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#0A100D" />
                    <stroke android:width="1dp" android:color="#39674A" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
